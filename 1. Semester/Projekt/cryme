#!/usr/bin/env node

const path = require('path');
module.paths.push(path.join(__dirname, 'web_app', 'node_modules'));

const {
  driver,
  initDatabase,
  migrateNodes,
  reconstructStateAtStep,
  computeStepDiff,
  renderGraphAscii,
  renderStepDiffAscii,
  renderStepShowAscii,
  getHeadStep
} = require('./web_app/oracle');

function printUsage() {
  console.log(`
🛡️  CRYME PQC Migration Oracle CLI Tool

Usage:
  cryme show node [id=<id_or_name>]          Inspect cryptographic nodes (all or one).
  cryme show tree                            Display migration steps as ASCII tree (HEAD marked).
  cryme show graph [step=<N>] [--before]     Dependency graph at step N or HEAD.
  cryme show step step=<N>                   Show step details (like git show).
  cryme show diff step=<N>                   Show step diff (like git diff).
  cryme migrate id=<id>[,id2,...] <algo>     Migrate one or more nodes (shared algorithm).
  cryme migrate id=<id>:<algo> [id=<id2>:<algo2> ...]  Per-node algorithms.
  cryme init                                 Reset DB and reload digital twin from YAML.

Examples:
  cryme show node
  cryme show node id=Webserver_Classic.KeyExchange_ECDHE
  cryme show tree
  cryme show graph step=2
  cryme show diff step=2
  cryme migrate id=355 TLS1.3
  cryme migrate id=359,362 X25519_MLKEM768
  cryme migrate id=Webserver_Classic.KeyExchange_ECDHE:X25519_MLKEM768 id=Client_Browser.KeyExchange_ECDHE:X25519_MLKEM768

