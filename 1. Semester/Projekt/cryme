async function showSystem() {
  const session = driver.session();
  try {
    const res = await session.run(`
      MATCH (n) 
      WHERE n:CryptoAsset OR n:SecurityControl 
      RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type, n.status AS status, n.active_algorithm AS algo
      ORDER BY n.id ASC
    `);
    
    console.log("\n" + "=".repeat(110));
    console.log(" ".repeat(40) + "🛡️  CRYME PQC SYSTEM STATUS ORACLE  🛡️");
    console.log("=".repeat(110));
    console.log(
      " " +
      "ID".padEnd(8) + " | " +
      "Type".padEnd(16) + " | " +
      "Component".padEnd(20) + " | " +
      "Asset / Control Name".padEnd(35) + " | " +
      "Status".padEnd(12) + " | " +
      "Algorithm"
    );
    console.log("-".repeat(110));
    
    res.records.forEach(rec => {
      const dbId = rec.get('db_id').toString();
      const nodeId = rec.get('node_id');
      const type = rec.get('type');
      const status = rec.get('status') || 'classic';
      const algo = rec.get('algo') || '-';
      
      const parts = nodeId.split('.');
      const comp = parts[0] || '-';
      const name = parts.slice(1).join('.').replace(/_/g, ' ') || nodeId;
      
      let statusColor = status === 'migrated' ? '\x1b[32mmigrated\x1b[0m' : '\x1b[31mclassic\x1b[0m';
      
      console.log(
        " " +
        dbId.padEnd(8) + " | " +
        type.padEnd(16) + " | " +
        comp.padEnd(20) + " | " +
        name.padEnd(35) + " | " +
        statusColor.padEnd(21) + " | " + // Pad adjusted to compensate for ANSI color escape chars
        algo
      );
    });
    console.log("=".repeat(110) + "\n");
  } catch (err) {
    console.error("[-] Error showing system: ", err.message);
  } finally {
    await session.close();
  }
}

// Fetch and print the migration tree as an ASCII art
async function showTree() {
  const session = driver.session();
  try {
    const nodeRes = await session.run("MATCH (s:MigrationStep) RETURN s.step as step, s.status as status, s.action as action, s.cluster as cluster, s.variants as variants ORDER BY s.step ASC");
    const edgeRes = await session.run("MATCH (a:MigrationStep)-[:TRANSITION_TO]->(b:MigrationStep) RETURN a.step as parent, b.step as child");
    
    const nodes = {};
    nodeRes.records.forEach(r => {
      let stVal = r.get('step');
      let stepNum = stVal.toNumber ? stVal.toNumber() : Number(stVal);
      let actionText = r.get('action') || '';
      const cluster = r.get('cluster') || [];
      const variantsStr = r.get('variants');

      if (actionText === 'migrate_success' && cluster.length > 0 && variantsStr) {
        try {
          const variants = JSON.parse(variantsStr);
          const algos = cluster.map(n => variants[n] ? variants[n].algorithm : 'PQC').join(', ');
          actionText = `Migrated ${cluster.join(', ')} to ${algos}`;
        } catch (e) {}
      } else if (actionText === 'redundant_migration' && cluster.length > 0) {
        actionText = `Redundant: ${cluster.join(', ')} already migrated`;
      } else if (actionText === 'migrate_fail' && cluster.length > 0) {
        actionText = `Failed to migrate ${cluster.join(', ')}`;
      } else if (actionText === 'migrate_success' && cluster.length === 0) {
        actionText = `Ghost Migration (No changes)`;
      }

      nodes[stepNum] = {
        step: stepNum,
        status: r.get('status'),
        action: actionText,
        children: []
      };
    });

    const hasParent = new Set();
    edgeRes.records.forEach(r => {
      let pVal = r.get('parent');
      let p = pVal.toNumber ? pVal.toNumber() : Number(pVal);
      let cVal = r.get('child');
      let c = cVal.toNumber ? cVal.toNumber() : Number(cVal);
      
      if (nodes[p] && nodes[c]) {
        nodes[p].children.push(nodes[c]);
        hasParent.add(c);
      }
    });

    const roots = Object.values(nodes).filter(n => !hasParent.has(n.step));
    
    function printTree(node, prefix = '', isLast = true) {
      let color = '\x1b[32m'; // success (green)
      if (node.status === 'failed') color = '\x1b[31m'; // fail (red)
      if (node.status === 'aborted') color = '\x1b[33m'; // aborted (yellow)
      if (node.status === 'init') color = '\x1b[36m'; // init (cyan)
      
      const marker = isLast ? '└── ' : '├── ';
      console.log(`${prefix}${marker}${color}[Step ${node.step}] ${node.status.toUpperCase()} (${node.action})\x1b[0m`);
      
      const newPrefix = prefix + (isLast ? '    ' : '│   ');
      node.children.sort((a,b) => a.step - b.step);
      for (let i = 0; i < node.children.length; i++) {
        printTree(node.children[i], newPrefix, i === node.children.length - 1);
      }
    }

    console.log("\\n🌲 PQC Migration Tree:");
    if (roots.length === 0) {
      console.log("  No migration steps found.\\n");
    } else {
      roots.sort((a,b) => a.step - b.step).forEach(root => {
        printTree(root, '', true);
      });
      console.log("");
    }
  } catch (err) {
    console.error("[-] Error showing tree: ", err.message);
  } finally {
    await session.close();
  }
}

// Find compatible variant for another node in the cluster
function findCompatibleVariant(nodeId, targetAlgo, state) {
  const vars = state.asset_variants[nodeId] || [];
  const targetFamily = targetAlgo.toLowerCase().split('-')[0].split('_')[0].split('.')[0];
  
  const match = vars.find(v => {
    const vFamily = v.algorithm.toLowerCase().split('-')[0].split('_')[0].split('.')[0];
    if ((targetFamily.includes("mlkem") && vFamily.includes("mlkem")) ||
        (targetFamily.includes("mldsa") && vFamily.includes("mldsa")) ||
        (targetFamily.includes("dilithium") && vFamily.includes("dilithium")) ||
        (targetFamily.includes("dilithium") && vFamily.includes("mldsa")) ||
        (targetFamily.includes("mldsa") && vFamily.includes("dilithium"))) {
      return true;
    }
    return targetFamily === vFamily;
  });
  
  return match || (vars.length > 0 ? vars[0] : null);
}

async function migrateNode(targetId, targetAlgo) {
  const session = driver.session();
  try {
    // 1. Load the current simulation state from Memgraph
    const state = await loadStateFromDB(session);

    // 2. Resolve the target node in Memgraph
    let query = "";
    let params = {};
    if (/^\d+$/.test(targetId)) {
      query = "MATCH (n) WHERE id(n) = $id OR n.id = $idStr RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type, n.status AS status, n.active_algorithm AS algo";
      params = { id: neo4j.int(targetId), idStr: targetId };
    } else {
      query = "MATCH (n) WHERE n.id = $id RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type, n.status AS status, n.active_algorithm AS algo";
      params = { id: targetId };
    }
    
    const res = await session.run(query, params);
    if (res.records.length === 0) {
      console.error(`[-] Error: Node with ID or name '${targetId}' not found in the database.`);
      return false;
    }

    const record = res.records[0];
    const dbId = record.get('db_id');
    const nodeId = record.get('node_id');
    const nodeType = record.get('type');

    if (nodeType !== 'CryptoAsset' && nodeType !== 'SecurityControl') {
      console.error(`[-] Error: Node '${nodeId}' is a '${nodeType}' and cannot be migrated.`);
      return false;
    }

    // 3. Find the target variant properties (if it's a CryptoAsset)
    let targetVariant = null;
    const activeAlgo = record.get('algo');
    const nodeStatus = record.get('status');

    if (nodeType === 'CryptoAsset') {
      const vars = state.asset_variants[nodeId] || [];
      targetVariant = vars.find(
        v => v.algorithm.toLowerCase() === targetAlgo.toLowerCase() || 
             v.variant_id.toLowerCase() === targetAlgo.toLowerCase()
      );
      if (!targetVariant) {
        const available = vars.map(v => `${v.algorithm} (${v.variant_id})`).join(', ');
        console.error(`[-] Error: Target algorithm/variant '${targetAlgo}' not available for asset '${nodeId}'.`);
        console.error(`Available variants: [${available || 'none'}]`);
        return false;
      }
      
    } else if (nodeType === 'SecurityControl') {
      // Just check existence
    }

    // 4. Query next step number and find the previous successful step
    const stepRes = await session.run("MATCH (s:MigrationStep) RETURN s.step as step, s.status as status");
    let stepNum = 1;
    let prevStep = 0;
    if (stepRes.records.length > 0) {
      let maxStep = 0;
      let lastSuccess = null;
      stepRes.records.forEach(rec => {
        let stVal = rec.get('step');
        let s = (stVal.toNumber ? stVal.toNumber() : Number(stVal));
        if (s > maxStep) maxStep = s;
        if (rec.get('status') === 'success' && (!lastSuccess || s > lastSuccess)) {
          lastSuccess = s;
        }
      });
      stepNum = maxStep + 1;
      prevStep = lastSuccess ? lastSuccess : 0;
    }

    // 5. Check if redundant migration, create dead-end leaf if so
    let isRedundant = false;
    let redundantAlgo = '';
    if (nodeType === 'CryptoAsset' && nodeStatus === 'migrated' && activeAlgo && activeAlgo.toLowerCase() === targetVariant.algorithm.toLowerCase()) {
      isRedundant = true;
      redundantAlgo = targetVariant.algorithm;
    } else if (nodeType === 'SecurityControl' && nodeStatus === 'migrated' && activeAlgo && activeAlgo.toLowerCase() === targetAlgo.toLowerCase()) {
      isRedundant = true;
      redundantAlgo = targetAlgo;
    }

    if (isRedundant) {
      console.log(`[!] Info: Node '${nodeId}' is already migrated to '${redundantAlgo}'. No action needed.`);
      await session.run(`
        MERGE (init:MigrationStep {step: 0})
        ON CREATE SET init.id = 'Step_0', init.status = 'init', init.action = 'system_start', init.timestamp = timestamp()
        WITH init
        CREATE (s:MigrationStep {
          id: $id, 
          step: $step, 
          timestamp: timestamp(), 
          status: 'aborted', 
          action: $action,
          cluster: $cluster,
          logs: $logs,
          log_file: $log_file
        })
        WITH s
        OPTIONAL MATCH (s_prev:MigrationStep {step: $prev})
        WHERE s_prev.status = 'success' OR s_prev.status = 'init'
        FOREACH (x IN CASE WHEN s_prev IS NOT NULL THEN [1] ELSE [] END |
          CREATE (s_prev)-[:TRANSITION_TO]->(s)
        )
      `, {
        id: `Step_${stepNum}_${Date.now()}_${Math.floor(Math.random()*1000)}`,
        step: stepNum,
        action: 'redundant_migration',
        cluster: [nodeId],
        logs: JSON.stringify(["[!] Redundant migration: Asset is already migrated to the requested algorithm."]),
        log_file: null,
        prev: prevStep
      });
      return true;
    }

    // Find the strongly connected component (SCC) cluster containing nodeId
    let sccs = computeSCCs(Array.from(state.nodes), Array.from(state.E_known));
    let nodeCluster = sccs.find(scc => scc.includes(nodeId)) || [nodeId];
    // We do not filter out nodes from state.S_nodes here because we want to allow re-migrating an asset to a different variant
    let clusterToMigrate = nodeCluster;

    // 5. Simulate the co-migration step state
    const proposedMigrated = new Set([...state.S_nodes, ...clusterToMigrate]);
    const proposedVariants = { ...state.active_variants };

    clusterToMigrate.forEach(n => {
      if (n === nodeId) {
        if (nodeType === 'CryptoAsset') {
          proposedVariants[n] = targetVariant;
        } else {
          proposedVariants[n] = {
            algorithm: targetAlgo,
            variant_id: targetAlgo,
            security_level: 0,
            key_size_bytes: 0,
            performance: "unknown"
          };
        }
      } else {
        const isAsset = (state.asset_variants[n] && state.asset_variants[n].length > 0);
        if (isAsset) {
          proposedVariants[n] = findCompatibleVariant(n, targetAlgo, state);
        } else {
          proposedVariants[n] = {
            algorithm: targetAlgo,
            variant_id: targetAlgo,
            security_level: 0,
            key_size_bytes: 0,
            performance: "unknown"
          };
        }
      }
    });

    // 6. Perform validation check
    const valResult = checkOracleValidation(proposedMigrated, proposedVariants, state);

    if (valResult.success) {
      // SUCCESS path
      
      // A. Mutate state in Memgraph database for all nodes in the co-migration cluster
      for (const node of clusterToMigrate) {
        const varSelected = proposedVariants[node];
        const algoName = varSelected ? varSelected.algorithm : 'Post-Quantum';
        await session.run(`
          MATCH (n) WHERE n.id = $nodeId
          SET n.status = 'migrated', n.migrated_at_step = $step, n.active_algorithm = $algo
        `, { nodeId: node, step: stepNum, algo: algoName });
      }

      // B. Generate Ansible playbook mapping all nodes in the cluster
      const playbook = generatePlaybookContent(clusterToMigrate, stepNum, proposedVariants);

      // C. Save files
      const files = savePlaybookAndLog(stepNum, true, "migrate_success", valResult.logs, playbook);

      // D. Create step node in DB
      const dbVariants = {};
      clusterToMigrate.forEach(n => {
        dbVariants[n] = proposedVariants[n];
      });

      await session.run(`
        MERGE (init:MigrationStep {step: 0})
        ON CREATE SET init.id = 'Step_0', init.status = 'init', init.action = 'system_start', init.timestamp = timestamp()
        WITH init
        CREATE (s:MigrationStep {
          id: $id, 
          step: $step, 
          timestamp: timestamp(), 
          status: 'success', 
          action: 'migrate_success',
          cluster: $cluster,
          logs: $logs,
          ansible: $ansible,
          variants: $variants,
          log_file: $log_file
        })
        WITH s
        OPTIONAL MATCH (s_prev:MigrationStep {step: $prev})
        WHERE s_prev.status = 'success' OR s_prev.status = 'init'
        FOREACH (x IN CASE WHEN s_prev IS NOT NULL THEN [1] ELSE [] END |
          CREATE (s_prev)-[:TRANSITION_TO]->(s)
        )
      `, {
        id: `Step_${stepNum}_${Date.now()}_${Math.floor(Math.random()*1000)}`,
        step: stepNum,
        cluster: Array.from(clusterToMigrate),
        logs: JSON.stringify(valResult.logs),
        ansible: playbook,
        variants: JSON.stringify(dbVariants),
        log_file: files.logFile,
        prev: prevStep
      });

      console.log(`\n\x1b[32m[+] MIGRATION STEP ${stepNum} SUCCESSFUL!\x1b[0m`);
      valResult.logs.forEach(l => console.log("  " + l));
      console.log(`\nPlaybook saved to: \x1b[33m${files.playbookFile}\x1b[0m`);
      console.log(`Logs written to:    \x1b[33m${files.logFile}\x1b[0m\n`);
      return true;
    } else {
      // FAILURE path
      const actionType = valResult.isStructural ? "migrate_fail" : "aborted_by_policy";
      let foundEdge = null;

      if (valResult.isStructural) {
        // Find implicit dependency for any node in the cluster
        let V_minus_Ci = Array.from(state.nodes).filter(n => !clusterToMigrate.includes(n));
        let candidates = V_minus_Ci.filter(n => !state.S_nodes.has(n));
        
        for (const u of clusterToMigrate) {
          for (const v of candidates) {
            if (state.E_implicit.has(`${u}->${v}`) || state.E_implicit.has(`${v}->${u}`)) {
              foundEdge = `${u}->${v}`;
              // Write newly discovered implicit link to database
              await session.run(`
                MATCH (src {id: $u})
                MATCH (tgt {id: $v})
                CREATE (src)-[:IMPLICIT_DEPENDENCY {discovered: true, detected_at_step: $step}]->(tgt)
                CREATE (tgt)-[:IMPLICIT_DEPENDENCY {discovered: true, detected_at_step: $step}]->(src)
              `, { u, v, step: stepNum });
              break;
            }
          }
          if (foundEdge) break;
        }
      }

      // Save files
      const files = savePlaybookAndLog(stepNum, false, actionType, valResult.logs);

      // Create failed/aborted MigrationStep node in DB
      await session.run(`
        MERGE (init:MigrationStep {step: 0})
        ON CREATE SET init.id = 'Step_0', init.status = 'init', init.action = 'system_start', init.timestamp = timestamp()
        WITH init
        CREATE (s:MigrationStep {
          id: $id, 
          step: $step, 
          timestamp: timestamp(), 
          status: $status, 
          action: $action,
          cluster: $cluster,
          logs: $logs,
          discovered_edge: $discovered_edge,
          log_file: $log_file
        })
        WITH s
        OPTIONAL MATCH (s_prev:MigrationStep {step: $prev})
        WHERE s_prev.status = 'success' OR s_prev.status = 'init'
        FOREACH (x IN CASE WHEN s_prev IS NOT NULL THEN [1] ELSE [] END |
          CREATE (s_prev)-[:TRANSITION_TO]->(s)
        )
      `, {
        id: `Step_${stepNum}_${Date.now()}_${Math.floor(Math.random()*1000)}`,
        step: stepNum,
        status: valResult.isStructural ? 'failed' : 'aborted',
        action: actionType,
        cluster: Array.from(clusterToMigrate),
        logs: JSON.stringify(valResult.logs),
        discovered_edge: foundEdge,
        log_file: files.logFile,
        prev: prevStep
      });

      console.log(`\n\x1b[31m[-] MIGRATION STEP ${stepNum} FAILED!\x1b[0m`);
      valResult.logs.forEach(l => console.log("  " + l));
      console.log(`\nLogs written to: \x1b[33m${files.logFile}\x1b[0m\n`);
      return false;
    }
  } catch (err) {
    console.error("[-] Error during migration: ", err.message);
    return false;
  } finally {
    await session.close();
  }
}

// MAIN CLI PARSING
const args = process.argv.slice(2);
if (args.length === 0) {
  printUsage();
  process.exit(1);
}

const command = args[0];
if (command === 'show' && args[1] === 'system') {
  showSystem().then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'tree') {
  showTree().then(() => process.exit(0));
} else if (command === 'migrate') {
  let idArg = args.find(a => a.startsWith('id='));
  let targetAlgo = args.filter(a => !a.startsWith('id=') && a !== 'migrate')[0];
  
  if (!idArg || !targetAlgo) {
    console.error("[-] Error: Missing id or target algorithm parameters.");
    printUsage();
    process.exit(1);
  }
  
  let targetId = idArg.split('=')[1];
  migrateNode(targetId, targetAlgo).then(success => {
    process.exit(success ? 0 : 1);
  });
} else {
  printUsage();
  process.exit(1);
}
