function parseMigrateTargets(args) {
  const idArgs = args.filter(a => a.startsWith('id='));
  if (idArgs.length === 0) return null;

  const perNodeMode = idArgs.some(a => a.includes(':') && a.split('=')[1].includes(':'));
  const targets = [];

  if (perNodeMode) {
    for (const idArg of idArgs) {
      const value = idArg.split('=').slice(1).join('=');
      const colonIdx = value.lastIndexOf(':');
      if (colonIdx === -1) {
        return { error: `Invalid per-node syntax '${idArg}'. Use id=nodeId:algorithm` };
      }
      targets.push({
        nodeId: value.slice(0, colonIdx),
        targetAlgo: value.slice(colonIdx + 1)
      });
    }
    return { targets };
  }

  const sharedAlgo = args.find(a => !a.startsWith('id=') && a !== 'migrate');
  if (!sharedAlgo) {
    return { error: 'Missing target algorithm. Use id=n1,n2 ALGO or id=n1:ALGO1 id=n2:ALGO2' };
  }

  for (const idArg of idArgs) {
    const ids = idArg.split('=')[1].split(',');
    ids.forEach(nodeId => {
      targets.push({ nodeId: nodeId.trim(), targetAlgo: sharedAlgo });
    });
  }
  return { targets };
}

async function runDeploy(args) {
  const stepNum = parseStepArg(args);
  if (stepNum === null || isNaN(stepNum)) {
    console.error("[-] Error: Missing or invalid step=N argument.");
    console.error("    Usage: cryme deploy step=2");
    process.exit(1);
  }

  const session = driver.session();
  try {
    const info = await getStepDeployInfo(session, stepNum);
    if (info.error) {
      console.error(`[-] Error: ${info.error}`);
      process.exit(1);
    }

    const varsDir = path.join(DEPLOY_ROOT, 'vars');
    if (!fs.existsSync(varsDir)) {
      fs.mkdirSync(varsDir, { recursive: true });
    }
    const varsFile = path.join(varsDir, `step_${stepNum}.json`);
    fs.writeFileSync(varsFile, JSON.stringify(info.deployVars, null, 2), 'utf8');

    const ansibleCfg = path.join(DEPLOY_ROOT, 'ansible.cfg');
    const inventory = path.join(DEPLOY_ROOT, 'inventory', 'hosts.ini');
    const playbook = path.join(DEPLOY_ROOT, 'playbooks', 'apply_tls.yml');

    if (!fs.existsSync(playbook)) {
      console.error(`[-] Error: Deploy playbook not found at ${playbook}`);
      process.exit(1);
    }

    console.log(`\n[+] Deploying CRYME TLS state for step ${stepNum} ...`);
    console.log(`    Migrated nodes: ${info.deployVars.migrated_nodes.join(', ')}`);
    console.log(`    Vars file:      deploy/vars/step_${stepNum}.json\n`);

    const result = spawnSync('ansible-playbook', [
      '-i', inventory,
      playbook,
      '-e', `@${varsFile}`
    ], {
      cwd: PROJECT_ROOT,
      env: { ...process.env, ANSIBLE_CONFIG: ansibleCfg },
      stdio: 'inherit'
    });

    if (result.status !== 0) {
      console.error(`\n[-] Ansible deploy failed (exit ${result.status ?? 'unknown'}).`);
      process.exit(result.status || 1);
    }

    console.log(`\n\x1b[32m[+] TLS deploy for step ${stepNum} completed.\x1b[0m`);
    console.log(`    Verify: cryme verify service step=${stepNum}\n`);
    process.exit(0);
  } catch (err) {
    console.error("[-] Error during deploy: ", err.message);
    process.exit(1);
  } finally {
    await session.close();
  }
}

function runVerifyTls(args) {
  runVerifyScript('verify_tls.sh', args);
}

function runVerifyService(args) {
  runVerifyScript('verify_service.sh', args);
}

function runVerifyScript(scriptName, args) {
  const verifyScript = path.join(DEPLOY_ROOT, scriptName);
  if (!fs.existsSync(verifyScript)) {
    console.error(`[-] Error: verify script not found at ${verifyScript}`);
    process.exit(1);
  }

  let mode = 'baseline';
  const stepNum = parseStepArg(args);
  if (stepNum !== null && !isNaN(stepNum)) {
    mode = `step=${stepNum}`;
  } else if (args.includes('baseline')) {
    mode = 'baseline';
  }

  const result = spawnSync('bash', [verifyScript, mode], {
    cwd: PROJECT_ROOT,
    stdio: 'inherit'
  });
  process.exit(result.status === 0 ? 0 : (result.status || 1));
}

async function runInit() {
  const session = driver.session();
  try {
    await initDatabase(session);
    console.log("\n\x1b[32m[+] Memgraph graph reset from webserver_pqc_twin.yaml\x1b[0m");

    const liveReset = resetLiveServiceState({
      log: (msg) => console.log(`\x1b[32m${msg}\x1b[0m`)
    });
    if (!liveReset.success) {
      console.error(`\x1b[33m[!] Live service reset failed: ${liveReset.error}\x1b[0m`);
      process.exit(1);
    }
    if (liveReset.warning) {
      console.log(`\x1b[33m[!] ${liveReset.warning}\x1b[0m`);
    }
    console.log("\n\x1b[32m[+] Live service reset to baseline (step 0, classic TLS)\x1b[0m");
    console.log("    Verify: curl -sk https://127.0.0.1:8443/api/status\n");
  } catch (err) {
    console.error("[-] Error initializing: ", err.message);
    process.exit(1);
  } finally {
    await session.close();
  }
}

async function runMigrate(args) {
  const parsed = parseMigrateTargets(args);
  if (!parsed) {
    console.error("[-] Error: Missing id= parameter.");
    printUsage();
    process.exit(1);
  }
  if (parsed.error) {
    console.error(`[-] Error: ${parsed.error}`);
    process.exit(1);
  }

  const session = driver.session();
  try {
    const result = await migrateNodes(session, parsed.targets, {
      log: (msg) => console.log(msg)
    });

    if (result.error) {
      console.error(`[-] Error: ${result.error}`);
      process.exit(1);
    }

    if (result.redundant) {
      process.exit(0);
    }

    if (result.success) {
      console.log(`\n\x1b[32m[+] MIGRATION STEP ${result.stepNum} SUCCESSFUL!\x1b[0m`);
      result.logs.forEach(l => console.log("  " + l));
      console.log(`\nPlaybook saved to: \x1b[33m${result.files.playbookFile}\x1b[0m`);
      console.log(`Logs written to:    \x1b[33m${result.files.logFile}\x1b[0m\n`);
      process.exit(0);
    }

    console.log(`\n\x1b[31m[-] MIGRATION STEP ${result.stepNum} FAILED!\x1b[0m`);
    result.logs.forEach(l => console.log("  " + l));
    console.log(`\nLogs written to: \x1b[33m${result.files.logFile}\x1b[0m\n`);
    process.exit(1);
  } catch (err) {
    console.error("[-] Error during migration: ", err.message);
    process.exit(1);
  } finally {
    await session.close();
  }
}

const args = process.argv.slice(2);
if (args.length === 0) {
  printUsage();
  process.exit(1);
}

const command = args[0];

if (command === 'show' && args[1] === 'system') {
  console.warn("[!] Deprecated: 'show system' — use 'show node' instead.");
  const idArg = args.find(a => a.startsWith('id='));
  showNode(idArg ? idArg.split('=')[1] : null).then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'node') {
  const idArg = args.find(a => a.startsWith('id='));
  showNode(idArg ? idArg.split('=')[1] : null).then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'tree') {
  showTree().then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'state') {
  showState(args.slice(2)).then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'graph') {
  showGraph(args.slice(2)).then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'step') {
  showStepDetail(args.slice(2)).then(() => process.exit(0));
} else if (command === 'show' && args[1] === 'diff') {
  showDiff(args.slice(2)).then(() => process.exit(0));
} else if (command === 'init') {
  runInit().then(() => process.exit(0));
} else if (command === 'deploy') {
  runDeploy(args.slice(1));
} else if (command === 'verify' && args[1] === 'tls') {
  runVerifyTls(args.slice(2));
} else if (command === 'verify' && args[1] === 'service') {
  runVerifyService(args.slice(2));
} else if (command === 'migrate') {
  runMigrate(args.slice(1));
} else {
  printUsage();
  process.exit(1);
}
