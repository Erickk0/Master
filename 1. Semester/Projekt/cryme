function parseStepArg(args) {
  const stepArg = args.find(a => a.startsWith('step='));
  if (!stepArg) return null;
  return parseInt(stepArg.split('=')[1], 10);
}

async function showNode(filterId) {
  const session = driver.session();
  try {
    let query = `
      MATCH (n)
      WHERE n:CryptoAsset OR n:SecurityControl
      RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type,
             n.status AS status, n.algorithm AS baseline, n.active_algorithm AS active
      ORDER BY n.id ASC
    `;
    let params = {};

    if (filterId) {
      if (/^\d+$/.test(filterId)) {
        query = `
          MATCH (n)
          WHERE (n:CryptoAsset OR n:SecurityControl) AND (id(n) = $id OR n.id = $idStr)
          RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type,
                 n.status AS status, n.algorithm AS baseline, n.active_algorithm AS active
        `;
        params = { id: require('neo4j-driver').int(filterId), idStr: filterId };
      } else {
        query = `
          MATCH (n)
          WHERE (n:CryptoAsset OR n:SecurityControl) AND n.id = $id
          RETURN id(n) AS db_id, n.id AS node_id, labels(n)[0] AS type,
                 n.status AS status, n.algorithm AS baseline, n.active_algorithm AS active
        `;
        params = { id: filterId };
      }
    }

    const res = await session.run(query, params);

    if (filterId && res.records.length === 0) {
      console.error(`[-] Error: Node '${filterId}' not found.`);
      return;
    }

    console.log("\n" + "=".repeat(120));
    console.log(" ".repeat(45) + "🛡️  CRYME PQC NODE STATUS ORACLE  🛡️");
    console.log("=".repeat(120));
    console.log(
      " " +
      "ID".padEnd(8) + " | " +
      "Type".padEnd(16) + " | " +
      "Component".padEnd(20) + " | " +
      "Asset / Control Name".padEnd(30) + " | " +
      "Status".padEnd(12) + " | " +
      "Baseline".padEnd(14) + " | " +
      "Active"
    );
    console.log("-".repeat(120));

    res.records.forEach(rec => {
      const dbId = rec.get('db_id').toString();
      const nodeId = rec.get('node_id');
      const type = rec.get('type');
      const status = rec.get('status') || 'classic';
      const baseline = rec.get('baseline') || '-';
      const active = rec.get('active') || '-';

      const parts = nodeId.split('.');
      const comp = parts[0] || '-';
      const name = parts.slice(1).join('.').replace(/_/g, ' ') || nodeId;

      const statusColor = status === 'migrated' ? '\x1b[32mmigrated\x1b[0m' : '\x1b[31mclassic\x1b[0m';

      console.log(
        " " +
        dbId.padEnd(8) + " | " +
        type.padEnd(16) + " | " +
        comp.padEnd(20) + " | " +
        name.padEnd(30) + " | " +
        statusColor.padEnd(21) + " | " +
        baseline.padEnd(14) + " | " +
        active
      );
    });
    console.log("=".repeat(120) + "\n");
  } catch (err) {
    console.error("[-] Error showing nodes: ", err.message);
  } finally {
    await session.close();
  }
}

async function showTree() {
  const session = driver.session();
  try {
    const headStep = await getHeadStep(session);
    const nodeRes = await session.run("MATCH (s:MigrationStep) RETURN s.step as step, s.status as status, s.action as action, s.cluster as cluster, s.variants as variants, s.head as head ORDER BY s.step ASC");
    const edgeRes = await session.run("MATCH (a:MigrationStep)-[:TRANSITION_TO]->(b:MigrationStep) RETURN a.step as parent, b.step as child");

    const nodes = {};
    nodeRes.records.forEach(r => {
      let stepNum = r.get('step').toNumber ? r.get('step').toNumber() : Number(r.get('step'));
      let actionText = r.get('action') || '';
      const cluster = r.get('cluster') || [];
      const variantsStr = r.get('variants');

      if (actionText === 'migrate_success' && cluster.length > 0 && variantsStr) {
        try {
          const variants = JSON.parse(variantsStr);
          const algos = cluster.map(n => variants[n] ? variants[n].algorithm : 'PQC').join(', ');
          actionText = `Migrated ${cluster.join(', ')} to ${algos}`;
        } catch (e) {}
      } else if (actionText === 'redundant_migration' && cluster.length > 0) {
        actionText = `Redundant: ${cluster.join(', ')} already migrated`;
      } else if (actionText === 'migrate_fail' && cluster.length > 0) {
        actionText = `Failed to migrate ${cluster.join(', ')}`;
      } else if (actionText === 'migrate_success' && cluster.length === 0) {
        actionText = `Ghost Migration (No changes)`;
      }

      nodes[stepNum] = {
        step: stepNum,
        status: r.get('status'),
        action: actionText,
        isHead: r.get('head') === true || stepNum === headStep,
        children: []
      };
    });

    const hasParent = new Set();
    edgeRes.records.forEach(r => {
      let p = r.get('parent').toNumber ? r.get('parent').toNumber() : Number(r.get('parent'));
      let c = r.get('child').toNumber ? r.get('child').toNumber() : Number(r.get('child'));

      if (nodes[p] && nodes[c]) {
        nodes[p].children.push(nodes[c]);
        hasParent.add(c);
      }
    });

    const roots = Object.values(nodes).filter(n => !hasParent.has(n.step));

    function printTree(node, prefix = '', isLast = true) {
      let color = '\x1b[32m';
      if (node.status === 'failed') color = '\x1b[31m';
      if (node.status === 'aborted') color = '\x1b[33m';
      if (node.status === 'init') color = '\x1b[36m';

      const headLabel = node.isHead ? ' \x1b[35m(HEAD)\x1b[0m' : '';
      const marker = isLast ? '└── ' : '├── ';
      console.log(`${prefix}${marker}${color}[Step ${node.step}] ${node.status.toUpperCase()} (${node.action})${headLabel}\x1b[0m`);

      const newPrefix = prefix + (isLast ? '    ' : '│   ');
      node.children.sort((a, b) => a.step - b.step);
      for (let i = 0; i < node.children.length; i++) {
        printTree(node.children[i], newPrefix, i === node.children.length - 1);
      }
    }

    console.log("\n🌲 PQC Migration Tree:");
    if (roots.length === 0) {
      console.log("  No migration steps found.\n");
    } else {
      roots.sort((a, b) => a.step - b.step).forEach(root => {
        printTree(root, '', true);
      });
      console.log("");
    }
  } catch (err) {
    console.error("[-] Error showing tree: ", err.message);
  } finally {
    await session.close();
  }
}

async function showState(args) {
  const session = driver.session();
  try {
    const stepNum = parseStepArg(args);
    const before = args.includes('--before');
    const headStep = await getHeadStep(session);
    const targetStep = stepNum !== null && !isNaN(stepNum) ? stepNum : headStep;

    const state = await reconstructStateAtStep(session, targetStep, { before });
    console.log(renderGraphAscii(state, {
      headStep,
      changedAtStep: before ? null : targetStep,
      title: 'CRYME SYSTEM STATE (Systemzustand)'
    }));
  } catch (err) {
    console.error("[-] Error showing state: ", err.message);
  } finally {
    await session.close();
  }
}

