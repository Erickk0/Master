# Copy to .env and fill in secrets
# Non-secret defaults mirror homelab/dockhand/values.yaml

# --- Dockhand runtime ---
DOCKHAND_IMAGE=fnsys/dockhand:latest
DOCKHAND_CONTAINER_NAME=dockhand
DOCKHAND_HOST_PORT=3000
DOCKHAND_CONTAINER_PORT=3000
DOCKHAND_DATA_DIR=./data

PUID=1000
PGID=1000
TZ=Europe/Berlin

# Required — generate once and keep backed up:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Set true only when Dockhand is served over HTTPS (reverse proxy)
COOKIE_SECURE=false

# Optional — only if compose volume path translation fails
# HOST_DATA_DIR=/full/host/path/to/homelab/dockhand/data

# Optional PostgreSQL (enable with: docker compose --profile postgres up -d)
# DATABASE_URL=postgres://dockhand:changeme@postgres:5432/dockhand
# POSTGRES_USER=dockhand
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=dockhand

# --- bountino private repo (configure in Dockhand UI after first login) ---
# Settings → Git → Credentials:
#   Name: github-bountino
#   Auth: HTTPS / password
#   Username: x-access-token
#   Password: <paste token below>
GITHUB_TOKEN=

# Git stack settings (for reference — set in Dockhand when creating the stack)
# GIT_REPO_URL=https://github.com/justinjd00/bountino.git
# GIT_REPO_BRANCH=main
# GIT_STACK_COMPOSE_PATH=docker-compose.yml
# GIT_STACK_ENV_FILE=.env

# --- Optional reverse proxy network ---
# REVERSE_PROXY_NETWORK=proxy
